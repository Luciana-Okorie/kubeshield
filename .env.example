# Local development defaults. Copy to .env and replace secrets before use.
KUBESHIELD_ENV=development
HTTP_ADDR=127.0.0.1:8110
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
DATABASE_URL=postgres://kubeshield:kubeshield_dev_only@localhost:5460/kubeshield?sslmode=disable
AUTO_MIGRATE=true
SESSION_TTL=12h
ALLOW_SIGNUP=true
TLS_CERT_FILE=
TLS_KEY_FILE=
TRUSTED_PROXIES=

# Scanner settings used by the legacy scanner API (cmd/kubeshield-api).
KUBECONFIG=
SCAN_CLUSTER_ID=dev
SCAN_INTERVAL=60s
API_KEY=replace-with-a-long-random-secret

# Optional cluster-agent settings (used by cmd/kubeshield-agent, not cmd/api).
KUBESHIELD_API_URL=http://127.0.0.1:8110
KUBESHIELD_AGENT_TOKEN=
KUBESHIELD_POLL_INTERVAL=5s
